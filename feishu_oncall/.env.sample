# func_oncall_template.py 环境变量示例
# 使用方式：
# 1. 在观测云 Func 中新建函数后，将需要的环境变量逐项复制到 Func 环境变量配置中。
# 2. 所有 <...> 都是占位符，必须替换为客户自己环境中的真实值。
# 3. 注释里的“示例”只用于说明格式，不要把示例密钥、示例 ID 原样用于生产。


# =============================================================================
# 一、观测云配置
# =============================================================================

# 观测云工作空间 API Key。
# 用途：调用观测云外部事件接口、故障中心 OpenAPI、值班表查询等接口。
# 示例：DF_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DF_API_KEY=<替换为观测云工作空间 API Key>

# 观测云外部事件 Webhook 地址。
# 用途：Func 将飞书群里的 @机器人消息转换为外部事件后，推送到这个地址，从而触发故障中心 Incident。
# 获取位置：观测云「监控 / 告警策略 / 外部事件」或对应外部事件接收器页面。
# 示例：GUANCE_WEBHOOK_URL=https://openapi.guance.com/api/v1/push-events/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/oncall
GUANCE_WEBHOOK_URL=https://openapi.guance.com/api/v1/push-events/<替换为外部事件 secret>/oncall

# 观测云 OpenAPI 基础地址。
# 用途：查询故障、修改故障状态、读取值班表和升级策略。
# 示例：中国区通常为 GUANCE_OPENAPI_BASE_URL=https://openapi.guance.com
GUANCE_OPENAPI_BASE_URL=https://openapi.guance.com


# =============================================================================
# 二、飞书应用配置
# =============================================================================

# 飞书应用 App ID。
# 用途：获取 tenant_access_token，用于发送/刷新飞书交互卡片。
# 注意：变量名沿用脚本内部的 LARK_* 命名，但这里配置的是飞书应用。
# 示例：LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_ID=<替换为飞书应用 App ID>

# 飞书应用 App Secret。
# 用途：配合 App ID 获取 tenant_access_token。
# 示例：LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_APP_SECRET=<替换为飞书应用 App Secret>

# 飞书事件订阅 Verify Token。
# 用途：校验飞书事件回调来源，防止非飞书请求误触发 Func。
# 获取位置：飞书开发者后台「事件与回调」里的 Verification Token。
# 示例：LARK_VERIFY_TOKEN=verify_xxxxxxxxxxxxxxxx
LARK_VERIFY_TOKEN=<替换为飞书事件订阅 Verify Token>

# 飞书 OpenAPI 基础地址。
# 用途：调用飞书发送消息、刷新卡片、处理卡片按钮回调。
# 示例：LARK_OPENAPI_BASE_URL=https://open.feishu.cn
LARK_OPENAPI_BASE_URL=https://open.feishu.cn


# =============================================================================
# 三、飞书消息触发条件
# =============================================================================

# 允许触发 OnCall 的机器人名称。
# 用途：只有消息内容中 @了这些机器人名称时，才会创建观测云外部事件。
# 建议：填写飞书群里用户实际看到的机器人名称。
# 示例：ONCALL_TRIGGER_BOT_NAMES=["OnCall Bot","故障值班机器人"]
ONCALL_TRIGGER_BOT_NAMES=["<替换为飞书机器人名称>"]

# 是否要求消息必须 @机器人。
# 用途：避免群里任意带 @ 的消息都触发故障。
# 推荐：生产环境保持 true。
# 示例：ONCALL_REQUIRE_BOT_MENTION=true
ONCALL_REQUIRE_BOT_MENTION=true

# 是否只处理群聊消息。
# 用途：防止单聊、其他会话类型触发 OnCall。
# 推荐：生产环境保持 true。
# 示例：ONCALL_REQUIRE_GROUP=true
ONCALL_REQUIRE_GROUP=true

# 允许处理的飞书消息类型。
# 用途：限制只有文本消息或富文本消息可以触发 OnCall。
# 示例：ONCALL_ALLOWED_MESSAGE_TYPES=["text","post"]
ONCALL_ALLOWED_MESSAGE_TYPES=["text","post"]

# 允许触发 OnCall 的飞书群 ID 白名单。
# 用途：限制只有指定客户群/服务群可以触发故障。
# 留空：[] 表示机器人所在且有事件权限的群都可触发。
# 示例：ONCALL_TARGET_CHAT_IDS=["oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"]
ONCALL_TARGET_CHAT_IDS=[]

# 飞书群 ID 到群名称的映射。
# 用途：当飞书事件中没有直接返回群名称时，用这里的名称展示在卡片和观测云事件中。
# 示例：ONCALL_KNOWN_CHAT_NAMES={"oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx":"客户服务群"}
ONCALL_KNOWN_CHAT_NAMES={}

# 飞书用户 ID 到用户名称的映射。
# 用途：当飞书事件中没有直接返回发送人名称时，用这里的名称展示在卡片和观测云事件中。
# 示例：ONCALL_KNOWN_USER_NAMES={"ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx":"张三"}
ONCALL_KNOWN_USER_NAMES={}


# =============================================================================
# 四、观测云外部事件内容
# =============================================================================

# 是否开启 dry run。
# 用途：true 时只打印日志，不真正推送观测云外部事件，适合本地或首次联调。
# 推荐：正式使用时为 false。
# 示例：ONCALL_DRY_RUN=false
ONCALL_DRY_RUN=false

# 外部事件状态。
# 用途：控制推送到观测云的事件状态，一般使用 fatal 触发故障中心流程。
# 示例：ONCALL_EVENT_STATUS=fatal
ONCALL_EVENT_STATUS=fatal

# 外部事件标题前缀。
# 用途：生成观测云事件标题，例如 P0Oncall: 数据库连接异常。
# 示例：ONCALL_TITLE_PREFIX=P0Oncall
ONCALL_TITLE_PREFIX=P0Oncall

# 外部事件来源标签。
# 用途：写入 dimension_tags.source，便于在观测云中筛选来源。
# 示例：ONCALL_SOURCE=feishu_oncall
ONCALL_SOURCE=feishu_oncall

# 外部事件服务名标签。
# 用途：写入 dimension_tags.service，便于按服务或场景聚合故障。
# 示例：ONCALL_SERVICE=customer_oncall
ONCALL_SERVICE=oncall

# 外部事件检测值。
# 用途：写入 check_value，一般保持 1 即可。
# 示例：ONCALL_CHECK_VALUE=1
ONCALL_CHECK_VALUE=1


# =============================================================================
# 五、请求超时、重试与 Incident 解析
# =============================================================================

# 观测云和飞书 OpenAPI 请求超时时间，单位：秒。
# 用途：控制 HTTP 请求最大等待时间。
# 示例：GUANCE_TIMEOUT_SECONDS=10
GUANCE_TIMEOUT_SECONDS=10

# 推送观测云外部事件失败时的重试次数。
# 用途：网络波动时自动重试。
# 示例：GUANCE_RETRY_COUNT=1
GUANCE_RETRY_COUNT=1

# 外部事件推送后，等待故障中心生成 Incident 的时间，单位：秒。
# 用途：脚本会在这段时间内尝试解析事件对应的 Incident，用于卡片展示和按钮回调。
# 建议：如果故障中心生成较慢，可调大到 20 或 30。
# 示例：GUANCE_INCIDENT_RESOLVE_SECONDS=12
GUANCE_INCIDENT_RESOLVE_SECONDS=12


# =============================================================================
# 六、飞书卡片行为
# =============================================================================

# 是否向飞书群发送交互卡片。
# 用途：true 时，触发故障后会在原群发送 Incident 状态卡片。
# 示例：ONCALL_SEND_CARD=true
ONCALL_SEND_CARD=true

# 是否更新同一张飞书卡片。
# 用途：true 时，卡片状态变化会对所有群成员可见；false 时可能只影响当前操作者视图。
# 推荐：生产环境保持 true。
# 示例：ONCALL_CARD_UPDATE_MULTI=true
ONCALL_CARD_UPDATE_MULTI=true

# Func 本地状态文件路径。
# 用途：保存 lark_oncall_id、飞书卡片 message_id、Incident UUID 等映射，用于后续回调刷新卡片。
# 注意：如果 Func 运行环境不保留 /tmp 状态，建议使用稳定可写路径或外部存储。
# 示例：ONCALL_STATE_FILE=/tmp/func_oncall_template_state.json
ONCALL_STATE_FILE=/tmp/func_oncall_template_state.json


# =============================================================================
# 七、观测云故障中心值班表与卡片展示
# =============================================================================

# 观测云值班表 UUID。
# 用途：脚本直接读取指定值班表。
# 说明：如果不知道 UUID，可以留空，脚本会使用 ONCALL_SCHEDULE_NAME 按名称查找。
# 示例：ONCALL_SCHEDULE_UUID=incsch_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ONCALL_SCHEDULE_UUID=

# 观测云值班表名称。
# 用途：当 ONCALL_SCHEDULE_UUID 为空时，脚本按这个名称查找值班表。
# 示例：ONCALL_SCHEDULE_NAME=oncall
ONCALL_SCHEDULE_NAME=oncall

# 值班人兜底展示文案。
# 用途：当脚本无法解析当前值班人时，在卡片里展示这个文案。
# 示例：ONCALL_TODAY_ONCALL=客户成功 OnCall 值班策略
ONCALL_TODAY_ONCALL=OnCall 值班策略

# 一线值班展示文案。
# 用途：控制飞书卡片中“一线”显示什么，不影响观测云真实值班表。
# 示例：ONCALL_LEVEL1_DISPLAY=一线：客户成功一线
ONCALL_LEVEL1_DISPLAY=一线：<替换为一线展示名>

# 二线值班展示文案。
# 用途：控制飞书卡片中“二线”显示什么，不影响观测云真实升级策略。
# 示例：ONCALL_LEVEL2_DISPLAY=二线：技术支持二线
ONCALL_LEVEL2_DISPLAY=二线：<替换为二线展示名>

# 三线值班展示文案。
# 用途：控制飞书卡片中“三线”显示什么，不影响观测云真实升级策略。
# 示例：ONCALL_LEVEL3_DISPLAY=三线：研发值班三线
ONCALL_LEVEL3_DISPLAY=三线：<替换为三线展示名>

# 多层级值班展示映射。
# 用途：当不止一线/二线/三线，或想统一用 JSON 管理展示名时使用。
# 说明：key 从 0 开始，0 表示一线，1 表示二线，2 表示三线。
# 示例：ONCALL_LEVEL_DISPLAYS={"0":"一线：客户成功","1":"二线：技术支持","2":"三线：研发专家"}
ONCALL_LEVEL_DISPLAYS={}


# =============================================================================
# 八、飞书卡片按钮权限
# =============================================================================

# 是否严格限制只有当前值班人可以点击卡片按钮。
# 用途：true 时，只有 ONCALL_GUANCE_ACCOUNT_MAP 中匹配到的值班人可以操作“待分配/处理中/已解决”按钮。
# 建议：首次联调可先设为 false；账号映射确认无误后再改为 true。
# 示例：ONCALL_STRICT_CARD_PERMISSION=false
ONCALL_STRICT_CARD_PERMISSION=false

# 观测云账号与飞书用户 ID 的映射。
# 用途：把观测云故障中心里的账号 UUID 映射到飞书用户，用于按钮权限校验和状态操作。
# key：观测云账号 UUID，例如 acnt_xxx。
# value.name：卡片和日志中展示的人名。
# value.lark_open_ids：飞书 open_id 列表。
# value.lark_user_ids：飞书 user_id 列表。
# value.lark_union_ids：飞书 union_id 列表。
# 说明：不同飞书回调可能返回 open_id、user_id 或 union_id，建议能拿到的都填上。
# 示例：ONCALL_GUANCE_ACCOUNT_MAP={"acnt_example_level1":{"name":"张三","lark_open_ids":["ou_example_level1"],"lark_user_ids":["user_example_level1"],"lark_union_ids":["on_example_level1"]},"acnt_example_level2":{"name":"李四","lark_open_ids":["ou_example_level2"],"lark_user_ids":["user_example_level2"],"lark_union_ids":["on_example_level2"]}}
ONCALL_GUANCE_ACCOUNT_MAP={"<替换为观测云账号 UUID 1>":{"name":"<替换为展示名 1>","lark_open_ids":["<替换为飞书 open_id 1>"],"lark_user_ids":["<替换为飞书 user_id 1>"],"lark_union_ids":["<替换为飞书 union_id 1>"]},"<替换为观测云账号 UUID 2>":{"name":"<替换为展示名 2>","lark_open_ids":["<替换为飞书 open_id 2>"],"lark_user_ids":["<替换为飞书 user_id 2>"],"lark_union_ids":["<替换为飞书 union_id 2>"]}}

